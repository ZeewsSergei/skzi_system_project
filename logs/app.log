            r.skzi_instance_number AS 'Номера экземпляров',
            1 AS 'Всего ключей',
            '' AS 'Примечание',
            strftime('%d.%m.%Y', r.withdrawal_date) AS 'Дата уничтожения'
        FROM skzi_registry r
        JOIN employees e ON r.employee_id = e.id
        WHERE r.status = 'DESTROYED'
         ORDER BY r.withdrawal_date, params=[]
